# Copy this file to .env and enter your own credentials.
# Use a NEW, EMPTY development database for this initial migration.
# Encode reserved characters in the username/password as URL components.
# For hosted PostgreSQL, use the provider's direct migration connection and TLS settings.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/write_with_you?schema=public"

# Neon direct connection for migrations. Runtime Prisma uses DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://..."
APP_URL="http://localhost:3000"

# Create a Clerk application with email verification enabled. Keep its secret server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/essays"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/essays"

# AI requires an explicitly selected model supporting Responses Structured Outputs.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6.1-sol"

# Neon deploy/env pull supplies these; never use NEXT_PUBLIC_ for them.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
NEON_FUNCTION_HELLO_BASE_URL=""

# Generate locally with npm run neon:secrets; deploy forwards this only to the function.
FUNCTION_API_KEY=""
