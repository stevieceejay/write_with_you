{
  "name": "write-with-you",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:preflight": "node --env-file=.env scripts/database-preflight.mjs",
    "db:migrate": "npm run db:preflight && prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:test": "node --env-file=.env --test tests/database.integration.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "typescript": "^5.0.0"
  }
}
